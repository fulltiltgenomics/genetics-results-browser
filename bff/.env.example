# standalone BFF (backend-for-frontend) configuration. export these vars before
# running `npm run bff:dev` (or rely on the defaults below). see refactor.md section 1.

# base URL of the upstream genetics-results-api, including the /api path segment.
# the BFF forwards /api/* here. defaults to the local API dev server.
GENETICS_API_URL=http://localhost:2000/api

# port the BFF listens on. the frontend's VITE_API_URL (dev) and the vite dev proxy
# both point at this port. defaults to 5000 (2000=API, 3000=vite, 4000=chat are taken).
BFF_PORT=5000

# in-process cache for assembled POST /v1/results responses (keyed by a hash of the query).
# repeated named-set queries (~900 variants) are slow upstream and cache extremely well. entry
# count is bounded because a single response can be several MB. TTL is a staleness safety-net
# only — a deploy restarts the process and clears the cache. set either to 0 to disable.
RESULTS_CACHE_MAX=50
RESULTS_CACHE_TTL_MS=86400000

# external LD API proxied by GET /api/v1/ld. proxied rather than called from the browser because
# the production CSP is `connect-src 'self'`. defaults to the FinnGen LD API.
LD_API_URL=https://api.finngen.fi/api/ld
